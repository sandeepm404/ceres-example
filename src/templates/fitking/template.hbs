<div class="fk-shell">

  {{!-- Top Red Bar --}}
  <div class="fk-top-red-bar"></div>

  {{!-- Letterhead --}}
  <div class="no-dibella fk-letterhead{{#unless invoice.letterHead}} is-empty{{/unless}}">
    {{#if invoice.letterHead}}
    <img src="{{invoice.letterHead}}" alt="Letterhead" data-ceres-height="letterhead" />
    {{else}}
    <img alt="Letterhead" data-ceres-height="letterhead" />
    {{/if}}
  </div>

  <div class="fk-page">

    {{!-- ═══ Header: Logos ═══ --}}
    <div class="fk-header">
      <div class="fk-header-left">
        {{#if invoice.billedBy.logo}}
        <img src="{{invoice.billedBy.logo}}" alt="{{invoice.billedBy.name}}" class="fk-logo" />
        {{/if}}
        <div style="margin-top:4px">{{> DemoBadge }}</div>
      </div>
      <div class="fk-header-right">
        {{#if invoice.billedTo.logo}}
        <img src="{{invoice.billedTo.logo}}" alt="{{invoice.billedTo.name}}" class="fk-logo" />
        {{/if}}
      </div>
    </div>

    {{!-- ═══ Outer Main Box Frame ═══ --}}
    <div class="fk-main-box">

      {{!-- ═══ Title Bar (Quotation) ═══ --}}
      <div class="fk-title-bar">
        <h1 class="fk-title">{{#if invoice.invoiceTitle}}{{invoice.invoiceTitle}}{{else}}Quotation{{/if}}</h1>
      </div>

      {{!-- ═══ Three-Column Info Section ═══ --}}
      <div class="fk-info-section">
        {{!-- Column 1: Quotation From --}}
        <div class="fk-info-col fk-info-from">
          <p class="fk-info-heading">{{#if invoice.customLabels.billedBy}}{{invoice.customLabels.billedBy}}{{else}}Quotation From{{/if}}</p>
          <p class="fk-info-value-bold">{{invoice.billedBy.name}}</p>
          {{#if invoice.billedBy.city}}<p class="fk-info-value">{{invoice.billedBy.city}} -</p>{{/if}}
          {{#if invoice.billedBy.phone}}
          <div class="fk-info-kv"><span class="fk-kv-key">Phone</span><span class="fk-kv-val">{{invoice.billedBy.phone}}</span></div>
          {{/if}}
          {{#if invoice.billedBy.email}}
          <div class="fk-info-kv"><span class="fk-kv-key">Email</span><span class="fk-kv-val">{{invoice.billedBy.email}}</span></div>
          {{/if}}
        </div>

        {{!-- Column 2: Quotation To --}}
        <div class="fk-info-col fk-info-to">
          <p class="fk-info-heading">{{#if invoice.customLabels.billedTo}}{{invoice.customLabels.billedTo}}{{else}}Quotation To{{/if}}</p>
          <p class="fk-info-value-bold">{{invoice.billedTo.name}}</p>
          {{#if invoice.billedTo.city}}<p class="fk-info-value">{{invoice.billedTo.city}} -</p>{{/if}}
          {{#if invoice.billedTo.phone}}
          <div class="fk-info-kv"><span class="fk-kv-key">Phone</span><span class="fk-kv-val">{{invoice.billedTo.phone}}</span></div>
          {{/if}}
          {{#if invoice.billedTo.email}}
          <div class="fk-info-kv"><span class="fk-kv-key">Email</span><span class="fk-kv-val">{{invoice.billedTo.email}}</span></div>
          {{/if}}
        </div>

        {{!-- Column 3: Quotation Details --}}
        <div class="fk-info-col fk-info-details">
          <p class="fk-info-heading">Quotation Details</p>
          <table class="fk-details-table">
            <tr>
              <td class="fk-dt-label">{{#if invoice.customLabels.invoiceNumber}}{{invoice.customLabels.invoiceNumber}}{{else}}Quotation No{{/if}}</td>
              <td class="fk-dt-value">{{invoice.invoiceNumber}}</td>
            </tr>
            <tr>
              <td class="fk-dt-label">{{#if invoice.customLabels.invoiceDate}}{{invoice.customLabels.invoiceDate}}{{else}}Quotation Date{{/if}}</td>
              <td class="fk-dt-value">{{formateShortDateWithOffset invoice.invoiceDate invoice.ownerOffset}}</td>
            </tr>
            {{#if invoice.billedTo._id}}
            <tr>
              <td class="fk-dt-label">Client ID</td>
              <td class="fk-dt-value">{{invoice.billedTo._id}}</td>
            </tr>
            {{/if}}
          </table>
        </div>
      </div>

      {{!-- ═══ Line Items Table ═══ --}}
      <div class="fk-table-wrap">
        <table class="fk-item-table">
          <thead>
            <tr>
              <th class="fk-col-sno"></th>
              <th colspan="2" class="fk-col-desc-photo">Product Description and Photo</th>
              <th class="fk-col-model">Model&nbsp;&nbsp;No</th>
              <th class="fk-col-price text-right">Unit Price</th>
              <th class="fk-col-qty text-center">Qty</th>
              <th class="fk-col-total text-right">Total</th>
            </tr>
          </thead>
          <tbody>
            {{#each invoice.items}}
            <tr>
              <td class="text-center fk-sno-cell">{{increment @index}}</td>
              <td class="fk-desc-cell">
                <p class="fk-item-name">{{name}}</p>
                {{#if description}}
                <div class="fk-item-desc">
                  {{> MarkdownViewer (prepareMarkdownViewerData description) }}
                </div>
                {{/if}}
              </td>
              <td class="fk-img-cell">
                {{#if thumbnail}}
                <img src="{{thumbnail}}" alt="{{name}}" class="fk-product-img" />
                {{/if}}
              </td>
              <td class="text-center fk-model-cell">{{sku}}</td>
              <td class="text-right fk-price-cell">{{rate}}</td>
              <td class="text-center fk-qty-cell">{{quantity}}{{#if unit}} {{unit}}{{else}} No{{/if}}</td>
              <td class="text-right fk-total-cell">{{amount}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{!-- ═══ Bottom Section: Terms (left) + Totals (right) ═══ --}}
      <div class="fk-bottom-section">
        {{!-- Left Side: Terms & Conditions + Remarks --}}
        <div class="fk-bottom-left">
          {{#if invoice.terms.0.terms.length}}
          <div class="fk-terms-section">
            <p class="fk-section-title">{{#if invoice.customLabels.terms}}{{invoice.customLabels.terms}}{{else}}Terms and Conditions{{/if}}</p>
            <ol class="fk-terms-list">
              {{#each invoice.terms.0.terms}}
              <li>{{this}}</li>
              {{/each}}
            </ol>
          </div>
          {{/if}}

          {{#if invoice.notes}}
          <div class="fk-remarks-section">
            <p class="fk-section-title">{{#if invoice.customLabels.notes}}{{invoice.customLabels.notes}}{{else}}Remarks{{/if}}</p>
            <div class="fk-remarks-content">
              {{> MarkdownViewer (prepareMarkdownViewerData invoice.notes) }}
            </div>
          </div>
          {{/if}}
        </div>

        {{!-- Right Side: Totals + Words + Signature --}}
        <div class="fk-bottom-right">
          <table class="fk-totals-table">
            <tr>
              <td class="fk-totals-label">Total</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}}{{#if invoice.finalTotal.subTotal}}{{invoice.finalTotal.subTotal}}{{else}}{{invoice.subTotal}}{{/if}}</td>
            </tr>
            {{#if invoice.finalTotal.igst}}
            <tr>
              <td class="fk-totals-label">GST @ 18%</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}} {{invoice.finalTotal.igst}}</td>
            </tr>
            {{/if}}
            {{#if invoice.finalTotal.cgst}}
            <tr>
              <td class="fk-totals-label">CGST</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}} {{invoice.finalTotal.cgst}}</td>
            </tr>
            {{/if}}
            {{#if invoice.finalTotal.sgst}}
            <tr>
              <td class="fk-totals-label">{{#if mapped.visibility.isUtgst}}UTGST{{else}}SGST{{/if}}</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}} {{invoice.finalTotal.sgst}}</td>
            </tr>
            {{/if}}
            {{#if invoice.finalTotal.roundOff}}
            <tr>
              <td class="fk-totals-label">Round off</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}} {{invoice.finalTotal.roundOff}}</td>
            </tr>
            {{/if}}
            <tr class="fk-grand-total-row">
              <td class="fk-totals-label">{{#if invoice.customLabels.total}}{{invoice.customLabels.total}}{{else}}Grand Total{{/if}}</td>
              <td class="fk-totals-value">{{invoice.customCurrencySymbol}}{{invoice.finalTotal.total}}</td>
            </tr>
          </table>

          {{!-- Amount in Words --}}
          {{#if invoice.customLabels.totalInWordsValue}}
          <div class="fk-amount-words">
            <p class="fk-amount-words-label">{{#if invoice.customLabels.totalInWords}}{{invoice.customLabels.totalInWords}}{{else}}Amount in words{{/if}}</p>
            <p class="fk-amount-words-value">{{invoice.customLabels.totalInWordsValue}}</p>
          </div>
          {{/if}}

          {{!-- Signature Box Area --}}
          <div class="fk-signature-container">
            <div class="fk-signature-box">
              {{#if invoice.billedBy.signature}}
              <img class="fk-stamp-img" src="{{invoice.billedBy.signature}}" alt="Stamp" />
              {{/if}}
            </div>
            <p class="fk-sig-label">Authorised Signatory</p>
          </div>
        </div>
      </div>

    </div>{{!-- .fk-main-box --}}

    {{!-- Bottom Left Red Curved Accent --}}
    <div class="fk-bottom-red-accent"></div>

  </div>{{!-- .fk-page --}}

  {{!-- Letterhead Footer --}}
  <div class="no-dibella fk-letterhead-footer{{#unless invoice.letterHeadFooter}} is-empty{{/unless}}">
    {{#if invoice.letterHeadFooter}}
    <img src="{{invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{else}}
    <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{/if}}
  </div>

</div>
