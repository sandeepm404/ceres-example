                          <h3 class="ax-card-title" data-role="title">{{title}}</h3>
                        </div>
                      {{else}}
                        <h3 class="ax-card-title" data-role="title">{{title}}</h3>
                      {{/if}}
                      <ul class="ax-terms">
                        {{#each items}}<li>{{this}}</li>{{/each}}
                      </ul>
                    </div>
                  {{/each}}
                </section>
              {{/if}}
              {{#if view.bank.show}}
                {{!-- The bank icon sits inline with the title; the rows start under the icon (user request). --}}
                <section class="ax-card ax-bank-card" data-testid="section" data-section="bank">
                  <div class="ax-bank-main">
                    <div class="ax-bank-head">
                      <span class="ax-card-icon" aria-hidden="true"><svg style="display: block;" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#22272F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M10 18v-7"/><path d="M11.119 2.205a2 2 0 0 1 1.762 0l7.84 3.846A.5.5 0 0 1 20.5 7h-17a.5.5 0 0 1-.22-.949z"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="M3 22h18"/><path d="M6 18v-7"/></svg></span>
                      {{#if view.bank.title}}<h3 class="ax-card-title" data-role="title">{{view.bank.title}}</h3>{{/if}}
                    </div>
                    <div class="ax-bank-body">
                      <div class="ax-kv ax-bank-rows">
                        {{#each view.bank.rows}}
                          <span class="ax-kv-label ax-bank-{{key}}">{{label}}</span>
                          <span class="ax-kv-value{{#if isNum}} ax-num{{/if}}"{{#if isNum}} data-testid="num"{{/if}}>{{value}}</span>
                        {{/each}}
                        {{#if view.bank.upi}}
                          <span class="ax-kv-label ax-bank-upi">{{view.bank.upi.label}}</span>
                          <span class="ax-kv-value ax-num" data-testid="num">{{view.bank.upi.id}}</span>
