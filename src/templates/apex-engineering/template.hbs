                    {{/each}}
                  </div>
                </section>
              {{/if}}
              {{#if view.infoRow.attachments}}
                <section class="ax-card" data-testid="section" data-section="attachments">
                  {{!-- The Terms heading's icon box, holding a link icon (user request). --}}
