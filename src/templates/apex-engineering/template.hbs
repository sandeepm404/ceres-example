                    <div class="ax-pay-cell">
                      {{#if figure}}<p class="ax-pay-figure ax-num">{{figure}}</p>{{/if}}
                      {{#if caption}}<p class="ax-pay-caption">{{caption}}</p>{{/if}}
                    </div>
                  {{/each}}
                </div>
              </section>
            {{/if}}

            {{#if view.contact}}
              <div class="ax-contact" data-testid="contact">
                {{!-- The heading and name, and the tax numbers below, on a purchase order only:
                      there the strip is the vendor (user request). --}}
                {{#if view.showsSeller}}
                  {{#if view.contact.name}}
                    <p class="ax-contact-party"><span class="ax-contact-title">{{view.contact.title}}</span> <span class="ax-contact-name">{{view.contact.name}}</span></p>
                  {{/if}}
                {{/if}}
                {{#if view.contact.address}}
                  <p class="ax-contact-row"><span class="ax-contact-icon" aria-hidden="true"><svg preserveAspectRatio="none" overflow="visible" style="display: block;" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="map-pin">
<path id="Vector" d="M14.9994 7.49996C14.9994 11.2451 10.8456 15.1454 9.4507 16.35C9.32076 16.4478 9.16258 16.5006 9 16.5006C8.83742 16.5006 8.67924 16.4478 8.5493 16.35C7.15443 15.1454 3.0006 11.2451 3.0006 7.49996C3.0006 5.90851 3.63268 4.38224 4.75778 3.25692C5.88289 2.1316 7.40886 1.4994 9 1.4994C10.5911 1.4994 12.1171 2.1316 13.2422 3.25692C14.3673 4.38224 14.9994 5.90851 14.9994 7.49996ZM11.2498 7.49996C11.2498 8.74271 10.2425 9.75016 9 9.75016C7.75748 9.75016 6.75023 8.74271 6.75023 7.49996C6.75023 6.2572 7.75748 5.24975 9 5.24975C10.2425 5.24975 11.2498 6.2572 11.2498 7.49996Z" stroke-width="1.5" stroke-linecap="round" stroke="#22272F"/>
</g>
</svg></span><span class="ax-contact-text">{{#if view.contact.street}}<span class="ax-address-line">{{view.contact.street}}</span>{{/if}}{{#if view.contact.region}}<span class="ax-address-line">{{view.contact.region}}</span>{{/if}}</span></p>
                {{/if}}
                {{#if view.contact.phone}}
                  <p class="ax-contact-row"><span class="ax-contact-icon" aria-hidden="true"><svg preserveAspectRatio="none" overflow="visible" style="display: block;" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="phone" clip-path="url(#clip0_0_34)">
<path id="Vector" d="M10.3741 12.4263C10.529 12.4974 10.7035 12.5137 10.8689 12.4724C11.0343 12.431 11.1807 12.3346 11.2839 12.199L11.5502 11.8502C11.6899 11.6639 11.8711 11.5127 12.0794 11.4086C12.2877 11.3044 12.5174 11.2502 12.7503 11.2502H15.0005C15.3983 11.2502 15.7799 11.4082 16.0612 11.6896C16.3426 11.9709 16.5006 12.3524 16.5006 12.7503V15.0005C16.5006 15.3983 16.3426 15.7799 16.0612 16.0612C15.7799 16.3426 15.3983 16.5006 15.0005 16.5006C11.4198 16.5006 7.98572 15.0782 5.45377 12.5462C2.92183 10.0143 1.4994 6.58023 1.4994 2.99952C1.4994 2.60166 1.65745 2.2201 1.93877 1.93877C2.2201 1.65745 2.60166 1.4994 2.99952 1.4994H5.2497C5.64756 1.4994 6.02912 1.65745 6.31044 1.93877C6.59177 2.2201 6.74982 2.60166 6.74982 2.99952V5.2497C6.74982 5.48259 6.6956 5.71227 6.59145 5.92057C6.4873 6.12887 6.33608 6.31006 6.14977 6.4498L5.79874 6.71307C5.66104 6.81821 5.56399 6.96778 5.52406 7.13636C5.48414 7.30495 5.50381 7.48216 5.57973 7.63789C6.60482 9.71996 8.29076 11.4038 10.3741 12.4263Z" stroke-width="1.5" stroke-linecap="round" stroke="#22272F"/>
</g>
<defs>
<clipPath id="clip0_0_34">
<rect width="18" height="18" fill="white"/>
</clipPath>
</defs>
</svg></span><span class="ax-contact-text ax-num">{{formatPhoneNumber view.contact.phone}}</span></p>
                {{/if}}
                {{#if view.contact.email}}
                  <p class="ax-contact-row"><span class="ax-contact-icon" aria-hidden="true"><svg preserveAspectRatio="none" overflow="visible" style="display: block;" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<g id="mail">
<path id="Vector" d="M16.5006 5.25038L9.75681 9.5452C9.52796 9.67809 9.26802 9.74809 9.00338 9.74809C8.73873 9.74809 8.47879 9.67809 8.24994 9.5452L1.4994 5.25038M16.5006 5.25038V4.50045C16.5006 3.67211 15.829 3.0006 15.0005 3.0006H2.99952C2.17103 3.0006 1.4994 3.67211 1.4994 4.50045V5.25038M16.5006 5.25038V13.4996C16.5006 14.3279 15.829 14.9994 15.0005 14.9994H2.99952C2.17103 14.9994 1.4994 14.3279 1.4994 13.4996V5.25038" stroke-width="1.5" stroke-linecap="round" stroke="#22272F"/>
</g>
</svg></span><span class="ax-contact-text ax-email">{{view.contact.email}}</span></p>
                {{/if}}
                {{#each view.brand.fields}}
                  <p class="ax-contact-row ax-contact-field"><span class="ax-contact-text"><span class="ax-field-label">{{label}}</span> {{#if isDate}}{{axDate value @root.invoice.ownerOffset}}{{else}}{{value}}{{/if}}</span></p>
                {{/each}}
              </div>
            {{/if}}


            {{!-- The signature closes the footer row on the right (user request); only when the
                  document has one. --}}
            {{#if view.signature.show}}
            <section class="ax-signature" data-testid="signature">
              {{#if view.signature.hasMark}}
                <div class="ax-signature-mark">
                  {{#if view.signature.image}}
                    {{> CeresImage src=view.signature.image alt=view.signature.label class="ax-signature-image"}}
                  {{else if view.signature.awaitingDigital}}
                    <div class="ax-signature-placeholder" aria-hidden="true"></div>
                    <p class="ax-signature-banner">Awaiting Digital Signature</p>
                  {{else if view.signature.signedDigital}}
                    <p class="ax-signature-banner">
                      Digitally signed{{#if view.signature.signerName}} by {{view.signature.signerName}}{{/if}}
                      {{#if view.signature.verifyUrl}}<a href="{{view.signature.verifyUrl}}" target="_blank" rel="noopener noreferrer">Verify</a>{{/if}}
                    </p>
                  {{/if}}
                </div>
              {{/if}}
              <div class="ax-signature-line"></div>
              {{#if view.signature.forLabel}}<p class="ax-signature-for">{{view.signature.forLabel}}</p>{{/if}}
              {{#if view.signature.label}}<p class="ax-signature-label">{{view.signature.label}}</p>{{/if}}
            </section>
            {{/if}}
          </footer>

          {{#if view.enquiry}}
            <p class="ax-enquiry" data-testid="enquiry" data-section="enquiry">{{view.enquiry.lead}}{{#if view.enquiry.email}} {{view.enquiry.emailLabel}} <strong class="ax-email">{{view.enquiry.email}}</strong>{{/if}}{{#if view.enquiry.phone}}{{#if view.enquiry.email}},{{/if}} {{view.enquiry.phoneLabel}} <strong class="ax-num">{{formatPhoneNumber view.enquiry.phone}}</strong>{{/if}}</p>
          {{/if}}

          {{> RefrensBranding @root.invoice}}
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  {{#unless view.hideFooter}}
    <div class="{{#if view.footerEveryPage}}no-dibella {{/if}}invoice-letterhead-footer ax-letterhead-footer{{#if view.footerEveryPage}} ax-footer-fixed{{/if}}{{#unless @root.invoice.letterHeadFooter}} is-empty{{/unless}}" data-ceres-page-footer data-ceres-page-policy="{{#if view.footerEveryPage}}all{{else}}last{{/if}}">
      {{#if @root.invoice.letterHeadFooter}}
        <img src="{{@root.invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
      {{else}}
        <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
      {{/if}}
    </div>
  {{/unless}}
</div>
{{/with}}
