                    <div class="ax-card-head">
                      <span class="ax-icon-box" aria-hidden="true"><svg style="display: block;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22272F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
