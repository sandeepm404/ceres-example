            </section>
          {{/if}}

          {{#if view.infoRow.show}}
            <div class="ax-row" data-pair="additional-attachments">
              {{#if view.infoRow.additional}}
                <section class="ax-card" data-testid="section" data-section="additional">
                  {{!-- The same icon box as the Terms heading (user request). --}}
                  {{#if view.infoRow.additional.title}}
                    <div class="ax-card-head">
                      <span class="ax-icon-box" aria-hidden="true"><svg preserveAspectRatio="none" overflow="visible" style="display: block;" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
